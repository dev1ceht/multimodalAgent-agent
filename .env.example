# Copy this file to .env and replace secrets with values for your environment.
# .env is loaded by Spring Boot for local runs and by Docker Compose for interpolation.

# Application
SERVER_PORT=8080
APP_HOST_PORT=8080
LOCAL_DB_URL=jdbc:h2:file:./data/multimodalAgent;MODE=MySQL;DATABASE_TO_LOWER=TRUE
LOCAL_DB_USERNAME=sa
LOCAL_DB_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379
MAIL_HOST=localhost
MAIL_PORT=1025
MANAGEMENT_SERVER_ADDRESS=127.0.0.1
MANAGEMENT_SERVER_PORT=9090
OTLP_TRACING_ENDPOINT=http://127.0.0.1:4318/v1/traces
AI_PROVIDER=ollama
AI_TEMPERATURE=0.35
AI_MAX_TOKENS=512
AI_CONTEXT_WINDOW=4096

# Ollama / chat model
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=multimodalAgent-qwen3.5-9b-benchmark:latest
OLLAMA_BENCHMARK_MODEL=multimodalAgent-qwen3.5-9b-benchmark:latest
OLLAMA_QWEN25_BENCHMARK_MODEL=multimodalAgent-qwen2.5-7b-benchmark:latest
OLLAMA_QWEN35_BENCHMARK_MODEL=multimodalAgent-qwen3.5-9b-benchmark:latest
MODEL_DIR_NAME=multimodalAgent-qwen3.5-9b
MODEL_FILE_NAME=qwen35-9b-psychqa-Q4_K_M.gguf
MODELFILE_NAME=Modelfile.qwen35-benchmark

# OpenAI-compatible chat provider (only used when AI_PROVIDER=openai)
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Embeddings (DashScope-compatible API)
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024

# Local host development
AUTH_SESSION_STORE=memory
DEMO_ACCOUNTS_ENABLED=true
REFRESH_COOKIE_SECURE=false
RAG_RETRIEVAL_MODE=LOCAL_BASELINE
USE_ELASTICSEARCH=false
ELASTICSEARCH_BASE_URL=http://localhost:9200
MCP_EXCEL_MODE=local
MCP_EMAIL_MODE=log

# Required application secrets. Use random values outside local development.
JWT_SECRET=replace-with-at-least-32-random-bytes
AUDIT_RESOURCE_HASH_SECRET=replace-with-a-random-audit-secret

# Optional audio / visual integrations
WHISPER_MODE=mock
WHISPER_BASE_URL=https://api.openai.com
WHISPER_API_KEY=
WHISPER_MODEL=whisper-1
MEDIAPIPE_MODE=local-rule
MEDIAPIPE_URL=http://localhost:8090/analyze

# Notification / MCP endpoints
MCP_EXCEL_URL=http://localhost:8080/mcp
MCP_EMAIL_URL=http://localhost:8080/mcp
ALERT_MAIL_FROM=multimodalAgent-alerts@example.com
ALERT_MAIL_RECIPIENTS=counselor-alerts@example.com

# Docker Compose application network overrides
DEV_DB_URL=jdbc:mysql://127.0.0.1:3306/multimodalAgent?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
COMPOSE_SPRING_PROFILES_ACTIVE=mysql
COMPOSE_MANAGEMENT_SERVER_PORT=9090
COMPOSE_DB_URL=jdbc:mysql://mysql:3306/multimodalAgent?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
MYSQL_DATABASE=multimodalAgent
MYSQL_USER=multimodalAgent
MYSQL_PASSWORD=replace-with-a-local-mysql-password
MYSQL_ROOT_PASSWORD=replace-with-a-local-mysql-root-password
COMPOSE_REDIS_HOST=redis
COMPOSE_ELASTICSEARCH_BASE_URL=http://elasticsearch:9200
COMPOSE_OLLAMA_BASE_URL=http://host.docker.internal:11434
COMPOSE_RAG_RETRIEVAL_MODE=ELASTICSEARCH_REQUIRED
COMPOSE_USE_ELASTICSEARCH=true
COMPOSE_OTLP_TRACING_ENDPOINT=http://tempo:4318/v1/traces
COMPOSE_MAIL_HOST=mailpit
COMPOSE_MAIL_PORT=1025
COMPOSE_MCP_EXCEL_MODE=local
COMPOSE_MCP_EMAIL_MODE=log
COMPOSE_MCP_EXCEL_URL=http://app:8080/mcp
COMPOSE_MCP_EMAIL_URL=http://app:8080/mcp
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-local-grafana-password

# Host ports used by Docker Compose
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379
ELASTICSEARCH_HOST_PORT=9200
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_WEB_HOST_PORT=8025
