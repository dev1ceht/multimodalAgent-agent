loki.source.file "multimodalagent" {
  targets = [
    {
      __path__     = "/var/log/multimodalagent/*.log",
      service_name = "multimodalAgent-agent",
      environment  = sys.env("DEPLOYMENT_ENVIRONMENT"),
    },
  ]

  forward_to = [loki.write.local.receiver]

  file_match {
    enabled     = true
    sync_period = "5s"
  }
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
